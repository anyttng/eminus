{
  "schemaVersion": 1,
  "id": "eminus",
  "version": "${version}",
  "name": "Eminus",
  "description": "Terrain far beyond the render distance: a coarse, persistent copy of every chunk you have seen, drawn as a far layer behind the game's own terrain. Runs on the game's OpenGL graphics API; Vulkan is in development.",
  "authors": [
    "Anyttng"
  ],
  "license": "MIT",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.eminus.client.EminusFabricClient"
    ],
    "modmenu": [
      "com.eminus.client.EminusModMenu"
    ],
    "sodium:config_api_user": [
      "com.eminus.compat.sodium.SodiumSettingsPage"
    ]
  },
  "mixins": [
    "eminus.mixins.json",
    "eminus.compat.sodium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "26.2"
  },
  "suggests": {
    "modmenu": "*"
  }
}
